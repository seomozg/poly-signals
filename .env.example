# ---- Public site ----
# Canonical origin used for canonical/hreflang/OG/sitemap (no trailing slash)
SITE_URL=http://localhost:3000

# Verifications for Yandex.Webmaster / Google Search Console (optional)
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# ---- Database ----
# SQLite file owned by the site (created automatically)
DATABASE_PATH=./data/poly_site.db

# ---- Polymarket Gamma API (public, no key required) ----
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# ---- DeepSeek (required for the analysis engine) ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---- Analysis engine tuning ----
# How many events are pulled from Polymarket per run (before filtering)
EVENTS_LIMIT=100
# How many filtered events are sent to the model per run (batches of 3)
ANALYZE_LIMIT=30
MIN_LIQUIDITY=300
MIN_MARKET_PRICE=0.01
MIN_EDGE=0.02
TARGET_SIGNALS_COUNT=8
ANALYZE_BATCH_SIZE=3
# Max markets analysed per event (keeps model replies within the token budget)
MAX_MARKETS_PER_EVENT=5
MAX_DAYS_AHEAD=30
MIN_HOURS_TO_END=6
# Events shorter than this (hours) are skipped
MIN_EVENT_DURATION_HOURS=2
# Comma-separated Polymarket tags to skip (ultra-short crypto flip markets)
EXCLUDED_TAGS=1M,5M,15M,30M,1H,Up or Down

# ---- Scheduler (cron, UTC) ----
ANALYSIS_CRON=0 0 * * *
PRICE_REFRESH_CRON=0 */3 * * *
ANALYSIS_MAX_AGE_HOURS=25
# How many NEW signals the daily job adds (0 disables the quota)
DAILY_NEW_SIGNALS=20

# Bearer token for POST /api/run-analysis (leave empty to disable the endpoint)
ANALYSIS_TOKEN=

# ---- One-off collection mode (npm run worker:collect) ----
COLLECT_TARGET=200
COLLECT_CONCURRENCY=3

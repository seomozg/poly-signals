{
  "name": "poly-site",
  "version": "1.0.0",
  "private": true,
  "description": "PolySignals — bilingual catalog of AI-analyzed Polymarket signals (Next.js 16 + DeepSeek pipeline + cron worker)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seomozg/poly-signals.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "worker:enrich": "tsx worker/index.ts --enrich-only",
    "worker:collect": "tsx worker/index.ts --collect",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "node-cron": "^4.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
